[template public forms(cls : Class)]
class [cls.name/]Form(forms.ModelForm):
    def as_div(self):
        return SafeString(super().as_div().replace("<div>", "<div class='form-group'>"))

    class Meta:
        model = [cls.name/]
        fields = ('__all__')
