    for key, value in payload.model_dump().items():
        setattr([cls.name.toLower()/], key, value)

    try:
        db.commit()
    except IntegrityError:
        db.rollback()
        raise HTTPException(status_code=400, detail="Invalid [cls.name.toLower()/] or duplicate relation")
    db.refresh([cls.name.toLower()/])
    return [cls.name.toLower()/]


def delete_[cls.name.toLower()/](db: Session, [cls.name.toLower()/]_id: int) -> None:
