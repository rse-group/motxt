def create_[cls.name.toLower()/](db: Session, payload: [cls.name/]Create) -> [cls.name/]:
    [cls.name.toLower()/] = [cls.name/](**payload.model_dump())
    db.add([cls.name.toLower()/])
    try:
        db.commit()
    except IntegrityError:
        db.rollback()
        raise HTTPException(status_code=400, detail="Invalid id or duplicate relation")
    db.refresh([cls.name.toLower()/])
    return [cls.name.toLower()/]


def list_[cls.name.toLower()/]s(db: Session) -> list['['/][cls.name/]]:
    return db.query([cls.name/]).all()


def get_[cls.name.toLower()/](db: Session, [cls.name.toLower()/]_id: int) -> [cls.name/]:
    [cls.name.toLower()/] = db.get([cls.name/], [cls.name.toLower()/]_id)
