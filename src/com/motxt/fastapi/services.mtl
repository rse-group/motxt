    return [cls.name.toLower()/]


def update_[cls.name.toLower()/](db: Session, [cls.name.toLower()/]_id: int, payload: [cls.name/]Update) -> [cls.name/]:
    [cls.name.toLower()/] = db.get([cls.name/], [cls.name.toLower()/]_id)
