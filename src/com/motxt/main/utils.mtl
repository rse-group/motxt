[comment encoding = UTF-8 /]
[module utils('http://www.eclipse.org/uml2/5.0.0/UML')]
[import com::motxt::main::sort/]

[query public toTitleCase(s : String) : String = 
    s.substring(1, 1).toUpper() + s.substring(2).toLower() 
/]

[query public toSnakeCase(s : String) : String = 
    s.replaceAll('([a-z])([A-Z])', '$1_$2').toLowerCase()
/]

[query public getAllClass(m : Model) : Sequence(Class) =
	m.sort()
/]


[query public getParentNames(c : Class) : String = 
    c.ancestors(Class).name->sep(', ')->toString()
/]

[query public targetFolder(m : Model) : String = 
	m.name+'/'
/]

[query public getTargetMain(m : Model) : String = 
	m.targetFolder()+'main/'
/]

[query public getTargetProject(m : Model) : String = 
	m.targetFolder()+m.name+'/'
/]

[query public mapDataTypeField(p : Property) : String = 
	if (p.type.oclIsUndefined()) then
		'models.TextField()'
	else if (p.type.name.toLower() = 'string') then 
        'models.CharField(max_length=255)'
    else if (p.type.name.toLower() = 'integer') then 
        'models.IntegerField()'
    else if (p.type.name.toLower() = 'boolean') then 
        'models.BooleanField(default=False)'
    else if (p.type.name.toLower() = 'float') then 
        'models.FloatField()'
	else if (p.type.name.toLower() = 'date') then
		'models.DateField(default=date.today, null=True, blank=True)'
	else if (p.type.name.toLower() = 'datetime') then
		'models.DateTimeField(default=timezone.now, null=True, blank=True)'
    else 
        'models.TextField()'
    endif endif endif endif endif endif endif
/]
[query public mapDataType(t : Type): String =
	if (t.name.oclIsUndefined()) then
		'None'
	else if (t.name.toLower() = 'string') then 
        'str'
    else if (t.name.toLower() = 'integer') then 
        'int'
    else if (t.name.toLower() = 'boolean') then 
        'bool'
    else if (t.name.toLower() = 'float') then 
        'float'
	else if (t.name.toLower() = 'date') then
		'date'
	else if (t.name.toLower() = 'datetime') then
		'datetime'
    else 
        'str'
    endif endif endif endif endif endif endif
/]
[**
 * Composite for Composition type
 * 
 * Shared for Aggregation type
 * 
 * Else Association
 * 
*/]
[query public getRelationType(p : Property): String =
	if (p.aggregation.toString() = 'composite' ) then
		'on_delete=models.CASCADE'
	else if (p.aggregation.toString() = 'shared') then
		'on_delete = models.SET_NULL, null=True'
	else 
		'on_delete=models.RESTRICT'
	endif endif
/]

[query public getParams(m : Operation): OrderedSet(Parameter) =
	m.ownedParameter->select(p | p.direction.toString()='in')
/]

[query private getReturn(m : Operation): Sequence(Parameter) =
m.ownedParameter->select(p | 
    not p.type.oclIsUndefined()
	and not p.type.oclIsInvalid()
	and p.direction.toString() = 'return'
	and p.type.name <> 'void'
	and p.name <> 'void'
)->asSequence()
/]

[template public getReturnType(m : Operation)]
[if (not(m.getReturn()->first().oclIsInvalid()))]->[m.getReturn()->first().type.mapDataType()/][/if]
[/template]