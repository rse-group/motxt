[comment encoding = UTF-8 /]
[module html('http://www.eclipse.org/uml2/5.0.0/UML')]
[import com::motxt::main::utils/]

[template public generateHTML(model : Model)]
[file (model.targetFolder()+'templates/base.html',false,'UTF-8')]
{% load static %}
<!DOCTYPE html>
<!--This code is generated using MoTxT, checkout more about us on https://motxt.ppl.cs.ui.ac.id-->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		{% block meta %}
		{% endblock meta %}
		<link rel="stylesheet" href="{% static 'css/style.css' %}">
	</head>

    <body>
        {% block content %}
        {% endblock content %}
    </body>
</html>
[/file]
[for (cls : Class | model.getAllClass())]
[file (model.getTargetMain()+'templates/create_' + cls.name.toLowerCase() + '.html', false, 'UTF-8')]
[cls.createHTML() /]
[/file]
[if (cls.ownedAttribute->select(association.oclIsUndefined())->notEmpty())]
[file (model.getTargetMain()+'templates/edit_' + cls.name.toLowerCase() + '.html', false, 'UTF-8')]
[cls.editHTML() /]
[/file]
[/if]
[file (model.getTargetMain()+'templates/'+cls.name.toLowerCase() + '_list.html', false, 'UTF-8')]
[cls.getHTML() /]
[/file]
[/for]
[model.landingPage()/]
[/template]

[template public landingPage(model : Model)]
[file (model.getTargetMain()+'templates/landing_page.html',false,'UTF-8')]
{% extends 'base.html' %}
{% block content %}
    <h1>Landing Page</h1>
    <h2>Models Available</h2>
    <table border="1">
        <thead>
            <tr>
                <th>Model Name</th>
                <th>View</th>
            </tr>
        </thead>
        <tbody>
            {% for model_name, model_label in model_info.items %}
            <tr>
                <td>{{ model_label }}</td>
                {% with url_name="main:get_"|add:model_name %}
                    <td><a href="{% url url_name %}">View {{ model_label }}</a></td>
                {% endwith %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock content %}
[/file]
[/template]

[template public createHTML(cls : Class)]
{% extends 'base.html' %}
{% block content %}
    <h1>Create [cls.name/] </h1>
    <form method="POST">
        {% csrf_token %}
        {{ form.as_p }}
        <button type="submit">Create [cls.name/]</button>
    </form>
{% endblock content %}
[/template]

[template public getHTML(cls : Class)]
[let has_edit : Boolean = cls.ownedAttribute->select(association.oclIsUndefined())->notEmpty()]
{% extends 'base.html' %}
{% load filter_tag %}
{% block content %}
	<button>
		<a href="{% url 'main:landing_page' %}">Back to Home</a>
	</button>
    <h1>[cls.name/] List</h1>
    <table border="1">
        <thead>
            <tr>
            {% for field in fields %}
                <th>{{ field }}</th>
            {% endfor -%}
            [if (has_edit)]
                <th>Edit</th>
            [/if]
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            {% for [cls.name.toSnakeCase()/], [cls.name.toSnakeCase()/]_dict in [cls.name.toSnakeCase()/]_data %}
            <tr>        
            {% for field in fields %}
                <td>{{ [cls.name.toSnakeCase()/]_dict|get_item:field }}</td>
            {% endfor -%}
            [if (has_edit)]
                <td>
                    <a href="{% url 'main:edit_[cls.name.toSnakeCase()/]' [cls.name.toSnakeCase()/].pk %}">
                        <button>Edit</button>
                    </a>
                </td>
            [/if]
                <td>
                    <form action="{% url 'main:delete_[cls.name.toSnakeCase()/]' %}" method="POST">
                        {% csrf_token %}
                        <input type="hidden" name="object_id" value="{{ [cls.name.toSnakeCase()/].id }}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="{{ fields|length|add:2 }}">No [cls.name.toSnakeCase()/]s to display.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <br>
    <a href="{% url 'main:create_[cls.name.toSnakeCase()/]' %}">Create New [cls.name/]</a>
{% endblock content %}
[/let]
[/template]

[template public editHTML(cls : Class)]
{% extends 'base.html' %}
{% block meta %}
<title>Edit [cls.name/]</title>
{% endblock meta %}
{% block content %}
    <h1>Edit [cls.name/]</h1>
    <form method="POST">
        {% csrf_token %}
        {{ form.as_p }}
        <button type="submit">Save</button>
    </form>
{% endblock content %}
[/template]