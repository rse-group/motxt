[comment encoding = UTF-8 /]
[module generate('http://www.eclipse.org/uml2/5.0.0/UML')]
[import com::motxt::django::models/]
[import com::motxt::django::views/]
[import com::motxt::django::urls/]
[import com::motxt::django::forms/]
[import com::motxt::django::html/]
[import com::motxt::main::utils/]
[import com::motxt::django::django/]

[template public generate(model : Model)]
[comment @main /]
[model.generateDjangoElements()/]
[/template]

[template public generateDjangoElements(model : Model)]
[file (model.getTargetMain()+'models.py', false, 'UTF-8')]
[model.djangoModels()/]
[/file]
[file (model.getTargetMain()+'views.py', false, 'UTF-8')]
[model.genViews()/]
[/file]
[model.generateUrls()/]
[model.generateForms()/]
[model.generateHTML()/]
[model.generateDjango()/]
[/template]