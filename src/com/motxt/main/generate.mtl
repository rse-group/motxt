[comment encoding = UTF-8 /]
[module generate('http://www.eclipse.org/uml2/5.0.0/UML')]
[import com::motxt::main::models/]
[import com::motxt::main::views/]
[import com::motxt::main::urls/]
[import com::motxt::main::forms/]
[import com::motxt::main::html/]
[import com::motxt::main::utils/]

[template public generateElements(model : Model)]
[comment @main/]
[model.generateModels()/]
[model.generateViews()/]
[model.generateUrls()/]
[model.generateForms()/]
[model.generateHTML()/]
[/template]

[template public generateModels(model : Model)]
[file ('models.py', false, 'UTF-8')]
[model.models()/]
[/file]
[/template]

[template public generateViews(model : Model)]
[file ('views.py', false, 'UTF-8')]
[model.genViews()/]
[/file]
[/template]