[comment encoding = UTF-8 /]
[module secretKey('http://www.eclipse.org/uml2/5.0.0/UML')]


[**
 * Return a 50 character random string usable as a SECRET_KEY setting value.
 */]
[query public generateSecretKey (o : OclAny) : String =
	invoke('id.ac.ui.cs.ppl.motxt.django.DjangoSecretKey', 'getRandomSecretKey()', Sequence{} ) 
 /]
