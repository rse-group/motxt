[comment encoding = UTF-8 /]
[module generate('http://www.eclipse.org/uml2/5.0.0/UML')]
[import id::ac::ui::cs::ppl::motxt::django::models/]
[import id::ac::ui::cs::ppl::motxt::django::views/]
[import id::ac::ui::cs::ppl::motxt::django::urls/]
[import id::ac::ui::cs::ppl::motxt::django::forms/]
[import id::ac::ui::cs::ppl::motxt::django::html/]
[import id::ac::ui::cs::ppl::motxt::main::utils/]
[import id::ac::ui::cs::ppl::motxt::django::django/]
[import id::ac::ui::cs::ppl::motxt::fastapi::models/]
[import id::ac::ui::cs::ppl::motxt::fastapi::fastapi/]
[import id::ac::ui::cs::ppl::motxt::react::react/]

[template public generate(model : Model)]
[comment @main /]
[model.generateFastAPIElements()/]
[comment][model.generateDjangoElements()/][/comment]
[comment][model.generateReact()/][/comment]
[/template]

[template public generate(model : Model, framework : String)]
[comment @main /]
[if (framework = 'FastAPI')]
	[model.generateFastAPIElements()/]
[elseif (framework = 'FastAPI-React')]
	[model.generateFastAPIElements()/]
	[model.generateReactElements()/]
[else]
	[model.generateDjangoElements()/]
[/if]
[/template]


[template public generateDjangoElements(model : Model)]
[file (model.getDjangoTargetMain()+'models.py', false, 'UTF-8')]
[model.djangoModels()/]
[/file]
[file (model.getDjangoTargetMain()+'views.py', false, 'UTF-8')]
[model.genViews()/]
[/file]
[model.generateUrls()/]
[model.generateForms()/]
[model.generateHTML()/]
[model.generateDjango()/]
[/template]

[template public generateFastAPIElements(model : Model)]
[model.generateFastAPIModels()/]
[model.generateFastAPI()/]
[/template]

[template public generateReactElements(model : Model)]
	[model.generateReact()/]
[/template]