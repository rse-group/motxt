[template private generateRunBat(model : Model)]
[file (model.targetFolder()+'run.bat', false, 'UTF-8')]
@echo off

REM Ask for environment folder name
set /p ENV_FOLDER="Enter the environment folder name (default: env): "

if "%ENV_FOLDER%"=="" (
    set ENV_FOLDER=env
)

REM Check if env folder exists
if exist "%ENV_FOLDER%" (
    echo Activating existing Django environment...
    call "%ENV_FOLDER%\Scripts\activate"
) else (
    echo Creating a new Django environment...
    python -m venv "%ENV_FOLDER%"
    call "%ENV_FOLDER%\Scripts\activate"
    echo Virtual environment with name "%ENV_FOLDER%" created and activated.
)

REM Install dependencies
if exist requirements.txt (
    echo Installing dependencies...
    pip install -r requirements.txt
) else (
    echo requirements.txt not found in the working directory!
    exit /b 1
)

REM Run Django migrations
echo Running migrations...
python manage.py makemigrations
python manage.py migrate

REM Start Django server
echo Starting Django server...
python manage.py runserver
[/file]
[/template]

[template private generateRunSh(model : Model)]
[file (model.targetFolder()+'run.sh', false, 'UTF-8')]
#!/bin/bash

# Ask for environment folder name
read -p "Enter the environment folder name (default: env): " ENV_FOLDER

if ['['/] -z "$ENV_FOLDER" ]; then
    ENV_FOLDER="env"
fi

# Check if the specified env folder exists
if ['['/] -d "$ENV_FOLDER" ]; then
    echo "Activating existing Django environment ($ENV_FOLDER)..."
    source "$ENV_FOLDER/bin/activate"
else
    echo "Creating a new Django environment ($ENV_FOLDER)..."
    python3 -m venv "$ENV_FOLDER"
    source "$ENV_FOLDER/bin/activate"
    echo "Virtual environment $ENV_FOLDER created and activated."
fi

# Install dependencies
if ['['/] -f "requirements.txt" ]; then
    echo "Installing dependencies..."
    pip install -r requirements.txt
else
    echo "requirements.txt not found in the working directory!"
    exit 1
fi

# Run Django migrations
echo "Running migrations..."
python manage.py makemigrations
python manage.py migrate

# Start Django server
echo "Starting Django server..."
python manage.py runserver
[/file]
[/template]

