[template private css(model : Model)]
/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Django form field styling (complements the @apply rules in base.html) */
.django-form-wrapper input,
.django-form-wrapper select,
.django-form-wrapper textarea {
  margin-top: 0.25rem;
  display: block;
  width: 100%;
  border-radius: 0.375rem;
  border: 1px solid #d1d5db;
  padding: 0.5rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.django-form-wrapper input:focus,
.django-form-wrapper select:focus,
.django-form-wrapper textarea:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
}

.django-form-wrapper p {
  margin-bottom: 1rem;
}

/* Dark mode form fields */
.dark .django-form-wrapper input,
.dark .django-form-wrapper select,
.dark .django-form-wrapper textarea {
  background-color: #1e293b;
  border-color: #475569;
  color: #e2e8f0;
}

.dark .django-form-wrapper input:focus,
.dark .django-form-wrapper select:focus,
.dark .django-form-wrapper textarea:focus {
  border-color: #60a5fa;
  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.3);
}

/* as_div form group styling */
.form-group {
  margin-bottom: 1rem;
}

.form-group label {
  display: inline-block;
  margin-bottom: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #475569;
}

.form-group input,
.form-group select,
.form-group textarea {
  display: block;
  width: 100%;
  border-radius: 0.75rem;
  border: 1px solid #94a3b8;
  background-color: rgba(255, 255, 255, 0.75);
  padding: 0.7rem 0.9rem;
  font-size: 0.875rem;
  color: #0f172a;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.form-group .helptext {
  display: block;
  margin-top: 0.4rem;
  font-size: 0.75rem;
  color: #64748b;
}

.form-group ul.errorlist {
  margin: 0 0 0.45rem;
  padding: 0;
  list-style: none;
  font-size: 0.75rem;
  font-weight: 600;
  color: #be123c;
}

.dark .form-group label {
  color: #cbd5e1;
}

.dark .form-group input,
.dark .form-group select,
.dark .form-group textarea {
  border-color: #475569;
  background-color: #1e293b;
  color: #e2e8f0;
}

.dark .form-group .helptext {
  color: #94a3b8;
}

.dark .form-group ul.errorlist {
  color: #fda4af;
}

/* as_div form group styling */
.form-group {
  margin-bottom: 1rem;
}

.form-group label {
