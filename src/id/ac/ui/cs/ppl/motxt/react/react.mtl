function DashboardPage() {
	[for (cls : Class | model.getAllClass())]
    const ['['/][cls.name.toLower()/]Count, set[cls.name.toTitleCase()/]Count] = useState(0)
	[/for]
    const ['['/]currentIndex, setCurrentIndex] = useState(0)
    const ['['/]isHovered, setIsHovered] = useState(false)
    const ['['/]isDocumentHidden, setIsDocumentHidden] = useState<boolean>(document.hidden)

    useEffect(() => {
        let isMounted = true
		[for (cls : Class | model.getAllClass())]
        const load[cls.name.toTitleCase()/]Count = async () => {
            try {
        const [cls.name.toLower()/]Rows = await list[cls.toListFunctionSuffix()/]()
                if (isMounted) {
                    set[cls.name.toTitleCase()/]Count([cls.name.toLower()/]Rows.length)
                }
            } catch {
                if (isMounted) {
                    set[cls.name.toTitleCase()/]Count(0)
                }
            }
        }

        void load[cls.name.toTitleCase()/]Count()
		[/for]
        return () => {
            isMounted = false
        }
    }, ['['/]])

    const entityCountByKey = useMemo<Record<string, number>>(() => {
      return {
  [for (cls : Class | model.getAllClass()) separator(',\n')]
        '[cls.toEntityKey()/]': [cls.name.toLower()/]Count
  [/for]
      }
    }, ['['/][for (cls : Class | model.getAllClass()) separator(', ')][cls.name.toLower()/]Count[/for]])

    const entityCards = useMemo<DashboardEntityCard['['/]]>(() => {
        return ENTITY_DEFINITIONS.map((entity) => ({
            key: entity.key,
            label: entity.label,
            fields: entity.fields,
        count: entityCountByKey['['/]entity.key] ?? 0,
            listPath: toEntityRoute(entity.path),
        createPath: `${toEntityRoute(entity.path)}/new`,
        }))
    }, ['['/]entityCountByKey])

    const totalSlides = entityCards.length
    const activeIndex = totalSlides === 0 ? 0 : currentIndex % totalSlides

    useEffect(() => {
        const onVisibilityChange = () => {
            setIsDocumentHidden(document.hidden)
        }

        document.addEventListener('visibilitychange', onVisibilityChange)
        return () => document.removeEventListener('visibilitychange', onVisibilityChange)
    }, ['['/]])

    useEffect(() => {
        if (isHovered || isDocumentHidden || totalSlides === 0) {
            return undefined
        }

        const timer = window.setInterval(() => {
            setCurrentIndex((previous) => (previous + 1) % totalSlides)
        }, 4500)

        return () => window.clearInterval(timer)
    }, ['['/]isHovered, isDocumentHidden, totalSlides])

    const getCardStyle = (index: number): CSSProperties => {
        if (totalSlides === 0) {
            return {}
        }

        const rawOffset = index - activeIndex
        const wrappedOffset =
            ((rawOffset + totalSlides + Math.floor(totalSlides / 2)) % totalSlides) -
            Math.floor(totalSlides / 2)
        const absOffset = Math.abs(wrappedOffset)
        const isVisible = absOffset <= 2
        const translateX = wrappedOffset * 110
        const scale = Math.max(0.7, 1 - absOffset * 0.12)
        const rotateY = wrappedOffset * -14
        const opacity = isVisible ? Math.max(0.2, 1 - absOffset * 0.28) : 0
        const zIndex = 40 - absOffset

        return {
            transform: `translate(-50%, -50%) translateX(${translateX}%) scale(${scale}) rotateY(${rotateY}deg)`,
            opacity,
            zIndex,
            filter: absOffset === 0 ? 'none' : 'saturate(0.85)',
            pointerEvents: absOffset === 0 ? 'auto' : 'none',
        }
    }

    const goPrevious = () => {
        if (totalSlides === 0) return
        setCurrentIndex((previous) => (previous - 1 + totalSlides) % totalSlides)
    }

    const goNext = () => {
        if (totalSlides === 0) return
        setCurrentIndex((previous) => (previous + 1) % totalSlides)
    }

    return (
        <>
            <section className="mx-4 rounded-3xl border border-white/20 bg-white/40 px-6 py-8 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/45 md:mx-8 md:px-10 lg:mx-12">
                <div className="flex flex-wrap items-center justify-between gap-4">
