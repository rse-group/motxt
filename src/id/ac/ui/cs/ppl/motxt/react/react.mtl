import { Navigate, Route, Routes } from 'react-router-dom'
import BaseLayout from './components/BaseLayout'
import DashboardPage from './pages/DashboardPage'
import LandingPage from './pages/LandingPage'
[for (cls : Class | model.getAllClass())]
import [cls.name.toUpperFirst()/]Page from './pages/[cls.name.toUpperFirst()/]Page'
import Create[cls.name.toUpperFirst()/]Page from './pages/Create[cls.name.toUpperFirst()/]Page'
import Edit[cls.name.toUpperFirst()/]Page from './pages/Edit[cls.name.toUpperFirst()/]Page'
[/for]
import './App.css'

function App() {
  return (
    <Routes>
      <Route element={<BaseLayout />}>
        <Route index element={<LandingPage />} />
        <Route path="dashboard" element={<DashboardPage />} />
[for (cls : Class | model.getAllClass())]
        <Route path="[cls.toRouteSegment()/]" element={<[cls.name.toUpperFirst()/]Page />} />
        <Route path="[cls.toRouteSegment()/]/new" element={<Create[cls.name.toUpperFirst()/]Page />} />
        <Route path="[cls.toRouteSegment()/]/:id/edit" element={<Edit[cls.name.toUpperFirst()/]Page />} />
[/for]
        <Route path="*" element={<Navigate to="/" replace />} />
      </Route>
    </Routes>
  )
}

export default App
[/file]
