import axios, { type AxiosResponse } from 'axios'
import type { EntityDefinition } from '../types/entities'

const api = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL ?? '/api',
  timeout: 10000,
})

const resolvedPathByEntityKey = new Map<string, string>()

function normalizeEndpointCandidate(candidate: string): string {
  let value = candidate.trim()

  if (!value.startsWith('/')) {
    value = `/${value}`
  }

  if (!value.endsWith('/')) {
    value = `${value}/`
  }

  return value
}

function getEndpointCandidates(entity: EntityDefinition): Array<string> {
  const baseCandidates =
    entity.endpointCandidates.length > 0
      ? entity.endpointCandidates
      : Array.of(`/${entity.path}/`)

  return baseCandidates.map((candidate) => normalizeEndpointCandidate(candidate))
}

async function withEndpointFallback<T>(
  entity: EntityDefinition,
  requestFn: (path: string) => Promise<T>,
): Promise<T> {
  const endpointCandidates = getEndpointCandidates(entity)
  const resolvedPath = resolvedPathByEntityKey.get(entity.key)

  const pathsToTry: Array<string> = resolvedPath
    ? Array.of(resolvedPath).concat(
        endpointCandidates.filter((path) => path !== resolvedPath),
      )
    : endpointCandidates

  let latestError: unknown = null

  for (const path of pathsToTry) {
    try {
      const response = await requestFn(path)
      resolvedPathByEntityKey.set(entity.key, path)
      return response
    } catch (error) {
      latestError = error
      const axiosError = axios.isAxiosError(error) ? error : null
      const statusCode = axiosError?.response?.status

      if (statusCode === 404 || statusCode === 405) {
        continue
      }

      throw error
    }
  }

  throw latestError ?? new Error(`Unable to resolve endpoint path for ${entity.label}.`)
}

function toRecord(value: unknown): Record<string, unknown> {
  if (typeof value === 'object' && value !== null) {
    return value as Record<string, unknown>
  }

  return {}
}

export function formatApiError(error: unknown): string {
  const axiosError = axios.isAxiosError(error) ? error : null

  if (!axiosError) {
    return 'An unexpected error occurred while contacting the API.'
  }

  const detail = Reflect.get(axiosError.response?.data ?? {}, 'detail')
  if (typeof detail === 'string') {
    return detail
  }

  if (axiosError.code === 'ECONNABORTED') {
    return 'Request timed out. Please make sure the backend is running.'
  }

  return axiosError.message || 'Unable to reach the API.'
}

export async function listEntities(entity: EntityDefinition): Promise<Array<Record<string, unknown>>> {
  const response = await withEndpointFallback<AxiosResponse<Array<unknown>>>(entity, (path) =>
    api.get<Array<unknown>>(path),
  )

  return response.data.map((row) => toRecord(row))
}

export async function getEntityById(
  entity: EntityDefinition,
  entityId: number,
): Promise<Record<string, unknown>> {
  const response = await withEndpointFallback<AxiosResponse<unknown>>(entity, (path) =>
    api.get<unknown>(`${path}${entityId}`),
  )

  return toRecord(response.data)
}

export async function createEntity(
  entity: EntityDefinition,
  payload: Record<string, unknown>,
): Promise<void> {
  await withEndpointFallback(entity, (path) => api.post(path, payload))
}

export async function updateEntity(
  entity: EntityDefinition,
  entityId: number,
  payload: Record<string, unknown>,
): Promise<void> {
  await withEndpointFallback(entity, (path) => api.put(`${path}${entityId}`, payload))
}

export async function deleteEntityById(
  entity: EntityDefinition,
  entityId: number,
): Promise<void> {
  await withEndpointFallback(entity, (path) => api.delete(`${path}${entityId}`))
}
