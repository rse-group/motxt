                    </div>

                    <div className="mt-4 flex justify-center gap-2">
                        {entityCards.map((entity, index) => (
                            <button
                                key={`${entity.key}-dot`}
                                type="button"
                                className={`carousel-dot h-2.5 w-2.5 rounded-full ${index === activeIndex ? 'bg-indigo-600 dark:bg-indigo-400' : 'bg-slate-300 dark:bg-slate-600'
                                    }`}
                                data-slide-index={index}
                                aria-label={`Go to ${entity.label}`}
                                onClick={() => setCurrentIndex(index)}
                            ></button>
                        ))}
                    </div>
                </div>
            </section>
        </>
    )
}

