                                className="carousel-card absolute left-1/2 top-1/2 flex h-['['/]360px] w-['['/]75vw] max-w-['['/]420px] -translate-x-1/2 -translate-y-1/2 flex-col rounded-2xl border border-slate-200/70 bg-gradient-to-br from-cyan-500 to-indigo-600 p-7 text-white shadow-2xl shadow-indigo-500/20 transition-all duration-500 ease-out dark:border-slate-700 max-['['/]360px]:h-['['/]330px] max-['['/]360px]:w-['['/]80vw] max-['['/]360px]:p-5 sm:h-['['/]420px] sm:w-['['/]420px] lg:h-['['/]480px] lg:w-['['/]460px]"
                                data-card-index={index}
