import axios, { type AxiosResponse } from 'axios'
import type { [cls.name.toUpperFirst()/] } from '../types/[cls.name.toLower()/]'

const api = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL ?? '/api',
  timeout: 10000,
})

const [cls.name.toLower()/]PathCandidates = ['['/]'/[cls.toApiSingularSegment()/]/', '/[cls.toApiPluralSegment()/]/'] as const

type [cls.name.toUpperFirst()/]Path = (typeof [cls.name.toLower()/]PathCandidates)['['/]number]

let resolved[cls.name.toUpperFirst()/]Path: [cls.name.toUpperFirst()/]Path | null = null

function normalize[cls.name.toUpperFirst()/](payload: unknown): [cls.name.toUpperFirst()/] {
  const data = (payload ?? {}) as Record<string, unknown>

  return {
    id: Number(data.id ?? 0),
[for (field : Property | cls.scalarFields())]
[if (field.toFieldKind() = 'number')]
    [field.name.toSnakeCase()/]: Number(data.[field.name.toSnakeCase()/] ?? 0),
[elseif (field.toFieldKind() = 'boolean')]
    [field.name.toSnakeCase()/]: Boolean(data.[field.name.toSnakeCase()/] ?? false),
[else]
    [field.name.toSnakeCase()/]: String(data.[field.name.toSnakeCase()/] ?? ''),
[/if]
[/for]
[for (field : Property | cls.foreignKeyFields())]
[if (field.isForeignKeyRequired() = 'true')]
    [field.getForeignKeyName()/]: Number(data.[field.getForeignKeyName()/] ?? 0),
[else]
    [field.getForeignKeyName()/]: data.[field.getForeignKeyName()/] === null || data.[field.getForeignKeyName()/] === undefined ? null : Number(data.[field.getForeignKeyName()/]),
[/if]
[/for]
  }
}

async function with[cls.name.toUpperFirst()/]PathFallback<T>(
  requestFn: (path: [cls.name.toUpperFirst()/]Path) => Promise<T>,
): Promise<T> {
  const pathsToTry: [cls.name.toUpperFirst()/]Path['['/]] = resolved[cls.name.toUpperFirst()/]Path
    ? ['['/]
        resolved[cls.name.toUpperFirst()/]Path,
        ...[cls.name.toLower()/]PathCandidates.filter((path) => path !== resolved[cls.name.toUpperFirst()/]Path),
      ]
    : ['['/]...[cls.name.toLower()/]PathCandidates]

  let latestError: unknown = null

  for (const path of pathsToTry) {
    try {
      const response = await requestFn(path)
      resolved[cls.name.toUpperFirst()/]Path = path
      return response
    } catch (error) {
      latestError = error
      const axiosError = axios.isAxiosError(error) ? error : null
      if (axiosError) {
        const statusCode = axiosError.response?.status
        if (statusCode === 404 || statusCode === 405) {
          continue
        }
      }
      throw error
    }
  }

  throw latestError ?? new Error('Unable to resolve [cls.name.toLower()/] endpoint path.')
}

export async function list[cls.toListFunctionSuffix()/](): Promise<[cls.name.toUpperFirst()/]['['/]]> {
  const response = await with[cls.name.toUpperFirst()/]PathFallback<AxiosResponse<unknown['['/]]>>((path) =>
    api.get<unknown['['/]]>(path),
  )

  return response.data.map((entry: unknown) => normalize[cls.name.toUpperFirst()/](entry))
}
