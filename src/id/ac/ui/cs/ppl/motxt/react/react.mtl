[file (model.getReactTargetProject()+'src/components/EntitySidebar.tsx', false, 'UTF-8')]
import { NavLink } from 'react-router-dom'
import { ENTITY_DEFINITIONS } from '../config/entities'

function EntitySidebar() {
  return (
    <aside className="sidebar">
      <h2 className="sidebar-title">Entities</h2>
      <nav className="sidebar-links">
        {ENTITY_DEFINITIONS.map((entity) => (
          <NavLink
            key={entity.key}
            to={`/${entity.path}`}
            className={({ isActive }) => (isActive ? 'sidebar-link active' : 'sidebar-link')}
          >
            {entity.label}
          </NavLink>
        ))}
      </nav>
    </aside>
  )
}

export default EntitySidebar
[/file]
[file (model.getReactTargetProject()+'src/types/entities.ts', false, 'UTF-8')]
export type EntityKey =
[for (cls : Class | model.getAllClass()) separator('\n\t| ')]
'[cls.toEntityKey()/]'
[/for]

export type EntityFieldKind = 'string' | 'number' | 'boolean' | 'date' | 'datetime'

export type EntityFieldInput = 'text' | 'number' | 'checkbox' | 'date' | 'datetime-local'

export type EntityField = {
  key: string
  label: string
  kind: EntityFieldKind
  input: EntityFieldInput
  required: boolean
  readOnly?: boolean
}

export type EntityDefinition = {
  key: EntityKey
  label: string
  path: string
  endpointCandidates: Array<string>
  fields: Array<EntityField>
}
export type DashboardEntityCard = {
  key: EntityKey
  label: string
  count: number
  fields: Array<EntityField>
  listPath: string
  createPath: string
