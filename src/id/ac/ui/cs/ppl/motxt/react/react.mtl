import { type ChangeEvent, type FormEvent, useCallback, useEffect, useMemo, useState } from 'react'
import { useSearchParams } from 'react-router-dom'
import { ENTITY_DEFINITIONS } from '../config/entities'
import { createEntity, deleteEntityById, formatApiError, listEntities, updateEntity } from '../lib/entityApi'
import type { EntityDefinition, EntityField } from '../types/entities'

type EntityPageProps = {
  entityKey: string
}

function normalizeDisplayValue(value: unknown): string {
  if (value === null || value === undefined || value === '') {
    return '-'
  }

  if (typeof value === 'boolean') {
    return value ? 'true' : 'false'
  }

  return String(value)
}

function getRowId(row: Record<string, unknown>): number {
  const rawId = Reflect.get(row, 'id')

  if (typeof rawId === 'number') {
    return rawId
  }

  const parsed = Number(rawId)
  return Number.isNaN(parsed) ? 0 : parsed
}

function createInitialState(entity: EntityDefinition): Record<string, unknown> {
  const initialState: Record<string, unknown> = {}

  entity.fields
    .filter((field) => !field.readOnly)
    .forEach((field) => {
      Reflect.set(initialState, field.key, field.input === 'checkbox' ? false : '')
    })

  return initialState
}

function mapFieldValue(field: EntityField, value: unknown): unknown {
  if (field.kind === 'boolean') {
    return Boolean(value)
  }

  if (field.kind === 'number') {
    if (value === '' || value === null || value === undefined) {
      return field.required ? 0 : null
    }

    const parsed = Number(value)
    return Number.isNaN(parsed) ? null : parsed
  }

  if (value === '' || value === null || value === undefined) {
    return field.required ? '' : null
  }

  return String(value)
}

function EntityPage({ entityKey }: EntityPageProps) {
  const ['['/]searchParams, setSearchParams] = useSearchParams()
  const entity = useMemo<EntityDefinition | undefined>(() => {
    return ENTITY_DEFINITIONS.find((candidate) => candidate.key === entityKey)
  }, ['['/]entityKey])

  const editableFields = useMemo<Array<EntityField>>(() => {
    if (!entity) {
      return Array.of()
    }

    return entity.fields.filter((field) => !field.readOnly)
  }, ['['/]entity])

  const ['['/]rows, setRows] = useState<Array<Record<string, unknown>>>(Array.of())
  const ['['/]isLoading, setIsLoading] = useState(true)
  const ['['/]isSubmitting, setIsSubmitting] = useState(false)
  const ['['/]pendingDeleteId, setPendingDeleteId] = useState<number | null>(null)
  const ['['/]isModalOpen, setIsModalOpen] = useState(false)
  const ['['/]editingRowId, setEditingRowId] = useState<number | null>(null)
  const ['['/]formState, setFormState] = useState<Record<string, unknown>>(Array.of())
  const ['['/]deleteTargetId, setDeleteTargetId] = useState<number | null>(null)
  const ['['/]errorMessage, setErrorMessage] = useState<string | null>(null)
  const ['['/]deleteErrorMessage, setDeleteErrorMessage] = useState<string | null>(null)

  const loadRows = useCallback(async () => {
    if (!entity) {
      setRows(Array.of())
      setIsLoading(false)
      return
    }

    setIsLoading(true)
    setErrorMessage(null)

    try {
      const responseRows = await listEntities(entity)
      setRows(responseRows)
    } catch (error) {
      setRows(Array.of())
      setErrorMessage(formatApiError(error))
    } finally {
      setIsLoading(false)
    }
  }, ['['/]entity])

  useEffect(() => {
    void loadRows()
  }, ['['/]loadRows])

  const openCreateModal = useCallback(() => {
    if (!entity) {
      return
    }

    setEditingRowId(null)
    setFormState(createInitialState(entity))
    setDeleteTargetId(null)
    setErrorMessage(null)
    setIsModalOpen(true)
  }, ['['/]entity])

  const openEditModalById = useCallback((rowId: number) => {
    if (!entity || rowId <= 0) {
      return
    }

    const sourceRow = rows.find((row) => getRowId(row) === rowId)
    const nextState = createInitialState(entity)

    if (sourceRow) {
      editableFields.forEach((field) => {
        const existingValue = Reflect.get(sourceRow, field.key)
        if (existingValue !== undefined && existingValue !== null) {
          Reflect.set(nextState, field.key, existingValue)
        }
      })
    }

    setEditingRowId(rowId)
    setFormState(nextState)
    setDeleteTargetId(null)
    setErrorMessage(null)
    setIsModalOpen(true)
  }, ['['/]editableFields, entity, rows])

  useEffect(() => {
    if (!entity) {
      return
    }

    const mode = searchParams.get('mode')
    const idRaw = searchParams.get('id')

    if (mode === 'create') {
      openCreateModal()
    } else if (mode === 'edit' && idRaw) {
      const parsedId = Number(idRaw)
      if (!Number.isNaN(parsedId) && parsedId > 0) {
        openEditModalById(parsedId)
      }
    } else {
      return
    }

    const nextParams = new URLSearchParams(searchParams)
    nextParams.delete('mode')
    nextParams.delete('id')
    setSearchParams(nextParams, { replace: true })
  }, ['['/]entity, openCreateModal, openEditModalById, searchParams, setSearchParams])

  const updateField = (fieldKey: string, value: unknown) => {
    setFormState((previous) => {
      const nextState = { ...previous }
      Reflect.set(nextState, fieldKey, value)
      return nextState
    })
  }

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()

    if (!entity) {
      return
    }

    const missingRequiredField = editableFields.find((field) => {
      if (!field.required || field.input === 'checkbox') {
        return false
      }

      const value = Reflect.get(formState, field.key)
      return value === '' || value === null || value === undefined
    })

    if (missingRequiredField) {
      setErrorMessage(`${missingRequiredField.label} is required.`)
      return
    }

    const payload: Record<string, unknown> = {}
    editableFields.forEach((field) => {
      const rawValue = Reflect.get(formState, field.key)
      Reflect.set(payload, field.key, mapFieldValue(field, rawValue))
    })

    setIsSubmitting(true)
    setErrorMessage(null)

    try {
      if (editingRowId && editingRowId > 0) {
        await updateEntity(entity, editingRowId, payload)
      } else {
        await createEntity(entity, payload)
      }

      setIsModalOpen(false)
      setEditingRowId(null)
      setFormState(createInitialState(entity))
      await loadRows()
    } catch (error) {
      setErrorMessage(formatApiError(error))
    } finally {
      setIsSubmitting(false)
    }
  }

  const openDeleteModal = (rowId: number) => {
    if (rowId <= 0 || pendingDeleteId !== null) {
      return
    }

    setDeleteErrorMessage(null)
    setDeleteTargetId(rowId)
  }

  const closeDeleteModal = () => {
    if (pendingDeleteId !== null) {
      return
    }

    setDeleteTargetId(null)
    setDeleteErrorMessage(null)
  }

  const handleDelete = async () => {
    if (!entity || !deleteTargetId || deleteTargetId <= 0 || pendingDeleteId !== null) {
      return
    }

    setDeleteErrorMessage(null)
    setPendingDeleteId(deleteTargetId)

    try {
      await deleteEntityById(entity, deleteTargetId)
      setDeleteTargetId(null)
      await loadRows()
    } catch (error) {
      setDeleteErrorMessage(formatApiError(error))
    } finally {
      setPendingDeleteId(null)
    }
  }

  if (!entity) {
    return (
      <section className="page-card">
        <h1 className="page-title">Unknown Entity</h1>
        <p className="page-subtitle">The requested entity key does not exist.</p>
      </section>
    )
  }

  return (
    <>
      <section className="relative mx-4 overflow-hidden md:mx-8 lg:mx-12">
        <div className="relative space-y-6">
          <header className="rounded-3xl border border-white/20 bg-white/60 px-4 py-6 shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/50 sm:px-6">
            <div className="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
              <div className="min-w-0 flex-1">
                <p className="text-xs font-semibold uppercase tracking-['['/]0.18em] text-slate-500 dark:text-slate-400">
                  Entity
                </p>
                <h1 className="mt-1 text-xl font-black tracking-tight text-slate-900 dark:text-white sm:text-2xl lg:text-3xl">
                  {entity.label} List
                </h1>
                <p className="mt-2 text-sm text-slate-600 dark:text-slate-300">
                  Manage {entity.label.toLowerCase()} records.
                </p>
              </div>
              <div className="flex gap-2">
                <button
                  type="button"
                  onClick={openCreateModal}
                  className="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-indigo-600 via-violet-600 to-fuchsia-600 px-4 py-2 text-xs font-semibold leading-none text-white shadow-lg shadow-violet-600/30 transition-transform duration-300 hover:-translate-y-0.5 sm:px-5 sm:py-2.5 sm:text-sm"
                >
                  Create New
                </button>
                <button type="button" onClick={() => void loadRows()} className="ghost-button">Reload</button>
              </div>
            </div>
          </header>

          {errorMessage && (
            <p className="rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 dark:border-rose-700 dark:bg-rose-900/30 dark:text-rose-200">
              {errorMessage}
            </p>
          )}

          <article className="overflow-hidden rounded-3xl border border-white/20 bg-white/60 shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/50">
            <div className="max-h-['['/]70vh] min-h-['['/]14rem] overflow-x-auto overflow-y-auto sm:min-h-['['/]20rem] lg:min-h-['['/]26rem]">
              <table className="min-w-max w-full divide-y divide-slate-200/70 dark:divide-slate-700/80" aria-label={`${entity.label} table`}>
                <thead className="bg-slate-100/80 dark:bg-slate-800/70">
                  <tr>
                    {entity.fields.map((field) => (
                      <th
                        key={`${entity.key}-header-${field.key}`}
                        className="whitespace-nowrap px-4 py-3 text-left text-xs font-semibold uppercase tracking-['['/]0.11em] text-slate-600 dark:text-slate-300 sm:px-6"
                      >
                        {field.label}
                      </th>
                    ))}
                    <th className="whitespace-nowrap px-4 py-3 text-left text-xs font-semibold uppercase tracking-['['/]0.11em] text-slate-600 dark:text-slate-300 sm:px-6">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-200/70 bg-white/30 dark:divide-slate-700/80 dark:bg-slate-900/10">
                  {isLoading && (
                    <tr>
                      <td colSpan={entity.fields.length + 1} className="px-4 py-8 text-center text-sm text-slate-600 dark:text-slate-300 sm:px-6">
                        Loading...
                      </td>
                    </tr>
                  )}

                  {!isLoading && rows.length === 0 && (
                    <tr>
                      <td colSpan={entity.fields.length + 1} className="px-4 py-8 text-center text-sm text-slate-600 dark:text-slate-300 sm:px-6">
                        No records found.
                      </td>
                    </tr>
                  )}

                  {!isLoading && rows.map((row) => {
                    const rowId = getRowId(row)

                    return (
                      <tr key={`${entity.key}-${rowId}`} className="transition-colors hover:bg-indigo-50/70 dark:hover:bg-slate-800/70">
                        {entity.fields.map((field) => (
                          <td
                            key={`${entity.key}-${rowId}-${field.key}`}
                            className="whitespace-nowrap px-4 py-3 text-sm text-slate-700 dark:text-slate-200 sm:px-6"
                          >
                            {normalizeDisplayValue(Reflect.get(row, field.key))}
                          </td>
                        ))}
                        <td className="whitespace-nowrap px-4 py-3 text-sm sm:px-6">
                          <div className="flex gap-2">
                            <button
                              type="button"
                              className="inline-flex items-center rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-1.5 font-semibold text-indigo-700 transition hover:bg-indigo-100 dark:border-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-200 dark:hover:bg-indigo-900/60"
                              onClick={() => openEditModalById(rowId)}
                              disabled={rowId <= 0}
                            >
                              Edit
                            </button>
                            <button
                              type="button"
                              className="inline-flex items-center rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 font-semibold text-rose-700 transition hover:bg-rose-100 disabled:cursor-not-allowed disabled:opacity-70 dark:border-rose-800 dark:bg-rose-900/30 dark:text-rose-300 dark:hover:bg-rose-900/50"
                              onClick={() => openDeleteModal(rowId)}
                              disabled={pendingDeleteId === rowId || rowId <= 0}
                            >
                              {pendingDeleteId === rowId ? 'Deleting...' : 'Delete'}
                            </button>
                          </div>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          </article>

          <button
            type="button"
            onClick={openCreateModal}
            className="fixed bottom-8 right-8 z-30 grid h-14 w-14 place-items-center rounded-full bg-gradient-to-r from-indigo-600 to-fuchsia-600 text-3xl font-bold text-white shadow-2xl shadow-indigo-500/30 transition-transform duration-300 hover:scale-105"
          >
            +
          </button>
        </div>
      </section>

      <section
        className={`fixed inset-0 z-50 items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm ${deleteTargetId ? 'flex' : 'hidden'}`}
        onMouseDown={(event) => {
          if (event.target === event.currentTarget) {
            closeDeleteModal()
          }
        }}
      >
        <div className="w-full max-w-lg rounded-3xl border border-white/20 bg-white/85 p-6 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/85">
          <h2 className="text-2xl font-black text-slate-900 dark:text-white">Delete {entity.label}</h2>
          <p className="mt-2 text-sm text-slate-600 dark:text-slate-300">This action cannot be undone.</p>

          {deleteErrorMessage && (
            <p className="mt-4 rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 dark:border-rose-700 dark:bg-rose-900/30 dark:text-rose-200">
              {deleteErrorMessage}
            </p>
          )}

          <div className="mt-5 flex justify-end gap-2">
            <button type="button" onClick={closeDeleteModal} disabled={pendingDeleteId !== null} className="ghost-button">Cancel</button>
            <button
              type="button"
              onClick={() => {
                void handleDelete()
              }}
              disabled={pendingDeleteId !== null}
              className="danger-button"
            >
              {pendingDeleteId !== null ? 'Deleting...' : 'Delete'}
            </button>
          </div>
        </div>
      </section>

      <section
        className={`fixed inset-0 z-40 items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm ${isModalOpen ? 'flex' : 'hidden'}`}
        onMouseDown={(event) => {
          if (event.target === event.currentTarget) {
            setIsModalOpen(false)
          }
        }}
      >
        <div className="w-full max-w-2xl rounded-3xl border border-white/20 bg-white/80 p-6 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/80">
          <div className="mb-5 flex items-start justify-between gap-4">
            <h2 className="text-2xl font-black text-slate-900 dark:text-white">
              {editingRowId ? `Edit ${entity.label}` : `Create ${entity.label}`}
            </h2>
            <button type="button" onClick={() => setIsModalOpen(false)} className="danger-button">Close</button>
          </div>

          <form onSubmit={handleSubmit} className="django-form-wrapper space-y-4">
            <div className="grid gap-4 sm:grid-cols-2">
              {editableFields.map((field) => {
                const inputId = `${entity.key}-${field.key}`
                const rawValue = Reflect.get(formState, field.key)

                if (field.input === 'checkbox') {
                  return (
                    <div className="form-group" key={field.key}>
                      <label htmlFor={inputId}>{field.label}</label>
                      <input
                        id={inputId}
                        type="checkbox"
                        checked={Boolean(rawValue)}
                        onChange={(currentEvent) => updateField(field.key, currentEvent.currentTarget.checked)}
                      />
                    </div>
                  )
                }

                return (
                  <div className="form-group" key={field.key}>
                    <label htmlFor={inputId}>{field.label}</label>
                    <input
                      id={inputId}
                      type={field.input}
                      value={String(rawValue ?? '')}
                      onChange={(currentEvent: ChangeEvent<HTMLInputElement>) => updateField(field.key, currentEvent.currentTarget.value)}
                      required={field.required}
                    />
                  </div>
                )
              })}
            </div>

            {errorMessage && (
              <p className="rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 dark:border-rose-700 dark:bg-rose-900/30 dark:text-rose-200">
                {errorMessage}
              </p>
            )}

            <button type="submit" disabled={isSubmitting} className="w-full rounded-xl bg-gradient-to-r from-indigo-600 via-violet-600 to-fuchsia-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition-transform duration-300 hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-80">
              {isSubmitting ? 'Saving...' : 'Save Record'}
            </button>
          </form>
        </div>
      </section>
    </>
  )
}

