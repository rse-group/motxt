import { useCallback, useEffect, useMemo, useState, type FormEvent } from 'react'
import { Link, useNavigate, useParams } from 'react-router-dom'
import { ENTITY_DEFINITIONS } from '../config/entities'
import { createEntity, formatApiError, getEntityById, updateEntity } from '../lib/entityApi'
import type { EntityDefinition, EntityField } from '../types/entities'

type EntityFormPageProps = {
  entityKey: string
  mode: 'create' | 'edit'
}

function createInitialState(entity: EntityDefinition): Record<string, unknown> {
  const initialState: Record<string, unknown> = {}

  entity.fields
    .filter((field) => !field.readOnly)
    .forEach((field) => {
      Reflect.set(initialState, field.key, field.input === 'checkbox' ? false : '')
    })

  return initialState
}

function isEmptyValue(value: unknown): boolean {
  return value === '' || value === null || value === undefined
}

function mapFieldValue(field: EntityField, value: unknown): unknown {
  if (field.kind === 'boolean') {
    return Boolean(value)
  }

  if (field.kind === 'number') {
    if (isEmptyValue(value)) {
      return field.required ? 0 : null
    }

    const parsed = Number(value)
    return Number.isNaN(parsed) ? null : parsed
  }

  if (isEmptyValue(value)) {
    return field.required ? '' : null
  }

  return String(value)
}

function EntityFormPage({ entityKey, mode }: EntityFormPageProps) {
  const navigate = useNavigate()
  const { id } = useParams()

  const entity = useMemo<EntityDefinition | undefined>(() => {
    return ENTITY_DEFINITIONS.find((candidate) => candidate.key === entityKey)
  }, ['['/]entityKey])

  const editableFields = useMemo<Array<EntityField>>(() => {
    if (!entity) {
      return Array.of()
    }

    return entity.fields.filter((field) => !field.readOnly)
  }, ['['/]entity])

  const ['['/]formState, setFormState] = useState<Record<string, unknown>>(() => {
    return entity ? createInitialState(entity) : {}
  })
  const ['['/]isSubmitting, setIsSubmitting] = useState(false)
  const ['['/]isLoading, setIsLoading] = useState(mode === 'edit')
  const ['['/]errorMessage, setErrorMessage] = useState<string | null>(null)

  useEffect(() => {
    if (!entity) {
      setFormState({})
      return
    }

    setFormState(createInitialState(entity))
  }, ['['/]entity])

  const loadEditData = useCallback(async () => {
    if (!entity || mode !== 'edit') {
      setIsLoading(false)
      return
    }

    const parsedId = Number(id)
    if (!id || Number.isNaN(parsedId) || parsedId <= 0) {
      setErrorMessage('Invalid record ID.')
      setIsLoading(false)
      return
    }

    setIsLoading(true)
    setErrorMessage(null)

    try {
      const payload = await getEntityById(entity, parsedId)
      const nextState = createInitialState(entity)

      editableFields.forEach((field) => {
        const existingValue = Reflect.get(payload, field.key)
        if (existingValue !== undefined && existingValue !== null) {
          Reflect.set(nextState, field.key, existingValue)
        }
      })

      setFormState(nextState)
    } catch (error) {
      setErrorMessage(formatApiError(error))
    } finally {
      setIsLoading(false)
    }
  }, ['['/]editableFields, entity, id, mode])

  useEffect(() => {
    void loadEditData()
  }, ['['/]loadEditData])

  const updateField = (fieldKey: string, value: unknown) => {
    setFormState((previous) => {
      const nextState = { ...previous }
      Reflect.set(nextState, fieldKey, value)
      return nextState
    })
  }

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()

    if (!entity) {
      return
    }

    const missingRequiredField = editableFields.find((field) => {
      if (!field.required) {
        return false
      }

      if (field.input === 'checkbox') {
        return false
      }

      return isEmptyValue(Reflect.get(formState, field.key))
    })

    if (missingRequiredField) {
      setErrorMessage(`${missingRequiredField.label} is required.`)
      return
    }

    const payload: Record<string, unknown> = {}
    editableFields.forEach((field) => {
      const rawValue = Reflect.get(formState, field.key)
      Reflect.set(payload, field.key, mapFieldValue(field, rawValue))
    })

    setIsSubmitting(true)
    setErrorMessage(null)

    try {
      if (mode === 'edit') {
        const parsedId = Number(id)
        if (!id || Number.isNaN(parsedId) || parsedId <= 0) {
          setErrorMessage('Invalid record ID.')
          setIsSubmitting(false)
          return
        }

        await updateEntity(entity, parsedId, payload)
      } else {
        await createEntity(entity, payload)
      }

      navigate(`/${entity.path}`)
    } catch (error) {
      setErrorMessage(formatApiError(error))
    } finally {
      setIsSubmitting(false)
    }
  }

  if (!entity) {
    return (
      <section className="page-card">
        <h1 className="page-title">Unknown Entity</h1>
        <p className="page-subtitle">The requested entity key does not exist.</p>
      </section>
    )
  }

  return (
    <section className="page-card">
      <h1 className="page-title">{mode === 'edit' ? `Edit ${entity.label}` : `Create ${entity.label}`}</h1>
      <p className="page-subtitle">Fill in the fields and save your record.</p>

      {errorMessage && <p className="feedback error">{errorMessage}</p>}

      {isLoading ? (
        <p className="feedback">Loading record...</p>
      ) : (
        <form onSubmit={handleSubmit}>
          <div className="form-grid">
            {editableFields.map((field) => {
              const inputId = `${entity.key}-${field.key}`
              const rawValue = Reflect.get(formState, field.key)

              if (field.input === 'checkbox') {
                return (
                  <div className="form-field" key={field.key}>
                    <label htmlFor={inputId}>{field.label}</label>
                    <input
                      id={inputId}
                      type="checkbox"
                      checked={Boolean(rawValue)}
                      onChange={(currentEvent) => updateField(field.key, currentEvent.currentTarget.checked)}
                    />
                  </div>
                )
              }

              return (
                <div className="form-field" key={field.key}>
                  <label htmlFor={inputId}>{field.label}</label>
                  <input
                    id={inputId}
                    type={field.input}
                    value={String(rawValue ?? '')}
                    onChange={(currentEvent) => updateField(field.key, currentEvent.currentTarget.value)}
                    required={field.required}
                  />
                </div>
              )
            })}
          </div>

          <div className="form-actions">
            <Link to={`/${entity.path}`} className="ghost-button">Cancel</Link>
            <button type="submit" className="primary-button" disabled={isSubmitting}>
              {isSubmitting ? 'Saving...' : 'Save'}
            </button>
          </div>
        </form>
      )}
    </section>
  )
}

export default EntityFormPage
[/file]
[/template]

[template private generateEntitySourceFiles(model : Model)]
[for (cls : Class | model.getAllClass())]
[file (model.getReactTargetProject()+'src/pages/'+cls.name.toUpperFirst()+'Page.tsx', false, 'UTF-8')]
import EntityPage from './EntityPage'

export default function [cls.name.toUpperFirst()/]Page() {
  return <EntityPage entityKey="[cls.toEntityKey()/]" />
}
[/file]
[file (model.getReactTargetProject()+'src/pages/Create'+cls.name.toUpperFirst()+'Page.tsx', false, 'UTF-8')]
import { Navigate } from 'react-router-dom'

export default function Create[cls.name.toUpperFirst()/]Page() {
  return <Navigate to="/[cls.toRouteSegment()/]?mode=create" replace />
}
[/file]
[file (model.getReactTargetProject()+'src/pages/Edit'+cls.name.toUpperFirst()+'Page.tsx', false, 'UTF-8')]
import { Navigate, useParams } from 'react-router-dom'

export default function Edit[cls.name.toUpperFirst()/]Page() {
  const { id } = useParams()
  const target = id ? `/[cls.toRouteSegment()/]?mode=edit&id=${id}` : '/[cls.toRouteSegment()/]'

  return <Navigate to={target} replace />
}
[/file]
[/for]
[/template]

[query private toEntityKey(cls : Class) : String =
  cls.name.toSnakeCase()
/]

[query private toRouteSegment(cls : Class) : String =
  if (cls.name.toSnakeCase().endsWith('s')) then cls.name.toSnakeCase() else cls.name.toSnakeCase() + 's' endif
/]

[query private toApiSingularSegment(cls : Class) : String =
  cls.name.toSnakeCase()
/]

[query private toApiPluralSegment(cls : Class) : String =
  cls.toRouteSegment()
/]

[query private toListFunctionSuffix(cls : Class) : String =
  if (cls.name.toLower().endsWith('s')) then cls.name.toUpperFirst() else cls.name.toUpperFirst() + 's' endif
/]

[query private scalarFields(cls : Class) : Sequence(Property) =
  cls.allAttributes()->select(p | (p.association.oclIsUndefined() or p.association.oclIsInvalid()) and p.name.toLower() <> 'id')->asSequence()
/]

[query private foreignKeyFields(cls : Class) : Sequence(Property) =
  cls.allAttributes()->select(p | p.association->notEmpty() and p.shouldOwnForeignKey())->asSequence()
/]

[query private toFieldLabel(name : String) : String =
  name.toSnakeCase().replaceAll('_', ' ').toUpperFirst()
/]

[query private toFieldKind(property : Property) : String =
  if (property.type.oclIsUndefined() or property.type.oclIsInvalid()) then
    'string'
  else if (property.type.name.toLower() = 'integer' or property.type.name.toLower() = 'float') then
    'number'
  else if (property.type.name.toLower() = 'boolean') then
    'boolean'
  else if (property.type.name.toLower() = 'date') then
    'date'
  else if (property.type.name.toLower() = 'datetime') then
    'datetime'
  else
    'string'
  endif endif endif endif endif
/]

[query private toInputType(property : Property) : String =
  if (property.type.oclIsUndefined() or property.type.oclIsInvalid()) then
    'text'
  else if (property.type.name.toLower() = 'integer' or property.type.name.toLower() = 'float') then
    'number'
  else if (property.type.name.toLower() = 'boolean') then
    'checkbox'
  else if (property.type.name.toLower() = 'date') then
    'date'
  else if (property.type.name.toLower() = 'datetime') then
    'datetime-local'
  else
    'text'
  endif endif endif endif endif
/]

[query private isRequired(property : Property) : String =
  if (property.lower = 0) then 'false' else 'true' endif
/]

[query private isForeignKeyRequired(property : Property) : String =
  if (property.isNullable() = 'False') then 'true' else 'false' endif
/]