[file (model.getReactTargetProject()+'src/App.css', false, 'UTF-8')]
html {
  scroll-behavior: smooth;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  width: 100%;
  flex-direction: column;
}

.app-header {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.45);
  background: rgba(248, 250, 252, 0.8);
  padding: 1rem 1.25rem;
  backdrop-filter: blur(12px);
}

.brand-link {
  font-size: 1.125rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #0f172a;
}

.top-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.top-nav-link {
  border: 1px solid rgba(100, 116, 139, 0.25);
  border-radius: 0.75rem;
  background-color: rgba(255, 255, 255, 0.75);
  color: #334155;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.45rem 0.8rem;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.top-nav-link:hover {
  background-color: rgba(238, 242, 255, 0.95);
  color: #312e81;
}

.main-layout {
  display: grid;
  flex: 1;
  gap: 1rem;
  grid-template-columns: 260px minmax(0, 1fr);
  padding: 1rem;
}

.sidebar {
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 1rem;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  padding: 1rem;
}

.sidebar-title {
  margin: 0;
  color: #0f172a;
  font-size: 1rem;
  font-weight: 800;
}

.sidebar-links {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  margin-top: 0.85rem;
}

.sidebar-link {
  border-radius: 0.7rem;
  color: #334155;
  font-size: 0.875rem;
  font-weight: 600;
  padding: 0.45rem 0.65rem;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.sidebar-link:hover {
  background-color: rgba(79, 70, 229, 0.08);
  color: #312e81;
}

.sidebar-link.active {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #ffffff;
}

.content-panel {
  min-width: 0;
}

.app-footer {
  border-top: 1px solid rgba(148, 163, 184, 0.35);
  color: #475569;
  font-size: 0.82rem;
  font-weight: 600;
  margin-top: auto;
  padding: 0.9rem 1.25rem;
}

.page-card {
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 1.25rem;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
  padding: 1.1rem;
}

.page-title {
  margin: 0;
  color: #0f172a;
  font-size: clamp(1.3rem, 1.8vw, 1.85rem);
  font-weight: 800;
  letter-spacing: -0.02em;
}

.page-subtitle {
  color: #475569;
  font-size: 0.92rem;
  margin: 0.35rem 0 0;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 1rem;
}

.primary-button,
.ghost-button,
.danger-button {
  border: 1px solid transparent;
  border-radius: 0.75rem;
  cursor: pointer;
  display: inline-flex;
  font-size: 0.875rem;
  font-weight: 700;
  line-height: 1;
  padding: 0.65rem 0.9rem;
  transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease;
}

.primary-button {
  background: linear-gradient(135deg, #4f46e5, #9333ea);
  color: #ffffff;
}

.ghost-button {
  border-color: rgba(100, 116, 139, 0.35);
  background: rgba(255, 255, 255, 0.72);
  color: #334155;
}

.danger-button {
  border-color: rgba(225, 29, 72, 0.4);
  background: rgba(255, 228, 230, 0.7);
  color: #9f1239;
}

.primary-button:hover,
.ghost-button:hover,
.danger-button:hover {
  transform: translateY(-1px);
}

.primary-button:disabled,
.ghost-button:disabled,
.danger-button:disabled {
  cursor: not-allowed;
  opacity: 0.6;
  transform: none;
}

.feedback {
  border-radius: 0.75rem;
  margin-top: 1rem;
  padding: 0.65rem 0.8rem;
  background-color: rgba(226, 232, 240, 0.8);
  color: #334155;
  font-size: 0.875rem;
}

.feedback.error {
  background-color: rgba(255, 228, 230, 0.95);
  color: #9f1239;
}

.table-wrap {
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 1rem;
  margin-top: 1rem;
  overflow: auto;
}

.entity-table {
  border-collapse: collapse;
  min-width: 680px;
  width: 100%;
}

.entity-table th,
.entity-table td {
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
  font-size: 0.875rem;
  padding: 0.72rem 0.75rem;
  text-align: left;
}

.entity-table thead th {
  background: rgba(226, 232, 240, 0.8);
  color: #334155;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.entity-table tbody tr:hover {
  background: rgba(238, 242, 255, 0.45);
}

.inline-actions {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.form-grid {
  display: grid;
  gap: 0.8rem;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  margin-top: 1rem;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.form-field label {
  color: #334155;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.form-field input,
.form-field select,
.form-field textarea {
  border: 1px solid #94a3b8;
  border-radius: 0.75rem;
  color: #0f172a;
  font-size: 0.9rem;
  padding: 0.62rem 0.75rem;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18);
  outline: none;
}

.form-field input['['/]type='checkbox'[']'/] {
  height: 1rem;
  margin-top: 0.2rem;
  width: 1rem;
}

.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 1rem;
}

@media (max-width: 960px) {
  .main-layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    order: 2;
  }

  .content-panel {
    order: 1;
  }

  .entity-table {
    min-width: 520px;
  }
}

.django-form-wrapper input,
.django-form-wrapper select,
.django-form-wrapper textarea {
  margin-top: 0.25rem;
  display: block;
  width: 100%;
  border-radius: 0.375rem;
  border: 1px solid #d1d5db;
  padding: 0.5rem;
  font-size: 0.875rem;
  line-height: 1.25rem;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.django-form-wrapper input:focus,
.django-form-wrapper select:focus,
.django-form-wrapper textarea:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
}

.django-form-wrapper p {
  margin-bottom: 1rem;
}

.dark .django-form-wrapper input,
.dark .django-form-wrapper select,
.dark .django-form-wrapper textarea {
  background-color: #1e293b;
  border-color: #475569;
  color: #e2e8f0;
}

.dark .django-form-wrapper input:focus,
.dark .django-form-wrapper select:focus,
.dark .django-form-wrapper textarea:focus {
  border-color: #60a5fa;
  box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.3);
}

.form-group {
  margin-bottom: 1rem;
}

.form-group label {
  display: inline-block;
  margin-bottom: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #475569;
}

.form-group input,
.form-group select,
.form-group textarea {
  display: block;
  width: 100%;
  border-radius: 0.75rem;
